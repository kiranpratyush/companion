<Window
    x:Class="HelloCompanion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hello Companion">
    <ScrollViewer>
        <Grid Padding="32" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Hello Companion" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Friendly desktop pets that keep you company while you work."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind StatusTitle, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind StatusDetail, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Desktop pets" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Transparent, click-through characters that never steal focus from your work."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="DesktopPetsToggle"
                        Header="Show desktop pets"
                        OffContent="Hidden"
                        OnContent="Visible" />

                    <TextBlock FontWeight="SemiBold" Text="Choose pets" />
                    <ListView
                        x:Name="AvailablePetsList"
                        DisplayMemberPath="DisplayName"
                        MaxHeight="220"
                        SelectionMode="Multiple" />

                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="Allowed behaviors" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Clear Roam to keep pets in place. Idle, sleep, and jump can still play while stationary."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ListView
                        x:Name="AvailableAnimationsList"
                        DisplayMemberPath="DisplayName"
                        MaxHeight="180"
                        SelectionMode="Multiple" />

                    <ComboBox
                        x:Name="PetMovementAreaComboBox"
                        Header="Movement area"
                        SelectedIndex="0">
                        <ComboBoxItem Content="Along the taskbar" Tag="Taskbar" />
                        <ComboBoxItem Content="Across the full screen" Tag="FullScreen" />
                    </ComboBox>

                    <TextBlock
                        x:Name="LoadedPetsText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Sleep mode" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Pause movement and let the pets sleep, with only occasional gentle messages."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="SleepModeToggle"
                        Header="Put pets to sleep"
                        OffContent="Disabled"
                        OnContent="Enabled" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="SavePets_Click" Content="Apply settings" Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="OpenPetsFolder_Click" Content="Open custom pets folder" />
                        <Button Click="ReloadPets_Click" Content="Reload characters" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Spacing="12">
                <InfoBar
                    x:Name="StatusInfoBar"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Error" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Closing this window keeps Hello Companion running in the notification area. Use Exit below or the tray menu to stop it completely."
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Left"
                    Click="Exit_Click"
                    Content="Exit Hello Companion" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
